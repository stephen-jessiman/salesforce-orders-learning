    <localTopics>
        <fullName>Order_Support_16jfj000001JdQ5</fullName>
        <canEscalate>false</canEscalate>
        <description>Handles inquiries related to order tracking, delays, and returns.</description>
        <developerName>Order_Support_16jfj000001JdQ5</developerName>
        <genAiPluginInstructions>
            <description>If the customer is not known, identify them by one of these paths: ask for their email address and run &apos;Get Customer Details&apos;, OR if they provide a PO number, run &apos;Get Order By PO Number&apos; first and use the account/contact context from the order to confirm identity. Either path is acceptable. Do not require email if the customer has already provided a PO number.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the customer asks about an order, ask for their PO number (if not already provided) and run &apos;Get Order By PO Number&apos; to retrieve the order. If they don&apos;t know the PO number, use context from &apos;Get Customer Details&apos; to help.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>To check shipment status, run &apos;Get Shipments For Order&apos; using the Order ID from &apos;Get Order By PO Number&apos;. Report all tracking numbers and delivery statuses.</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 3</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If a shipment has Delivery Status &apos;Exception&apos;, explain the delay clearly, share the Exception Reason and the Last Tracking Update datetime.</description>
            <developerName>instruction_4</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 4</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the customer asks about a return, run &apos;Get Return Details&apos; to retrieve the return record. Share the RMA number, status, and reason.</description>
            <developerName>instruction_5</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 5</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the customer needs to open a support case, run &apos;Create Support Case&apos; with their Contact ID, a clear subject, and description summarizing the issue.</description>
            <developerName>instruction_6</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 6</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Keep replies concise. Always include tracking numbers, ETAs, and RMA numbers when available.</description>
            <developerName>instructions_0_1770395103147</developerName>
            <language>en_US</language>
            <masterLabel>instructions_0_1770395103147</masterLabel>
            <sortOrder>6</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Treat order status, shipment delay, return requests, and case updates as in-scope. These are operational support requests.</description>
            <developerName>instructions_0_1770395228868</developerName>
            <language>en_US</language>
            <masterLabel>instructions_0_1770395228868</masterLabel>
            <sortOrder>7</sortOrder>
        </genAiPluginInstructions>
